ANTHROPIC_API_KEY=sk-ant-your-key-here

# Claude model for receipt parsing.
# Use a semantic alias: small (Haiku), medium (Sonnet), large (Opus)
# Or specify an exact model ID like "claude-sonnet-4-6-20250610"
# Default: medium
# R2S_MODEL=medium

# Max file size for receipt uploads (in MB).
# Claude's vision API accepts up to ~20 MB per image, but larger files use
# more tokens and cost more. PDF text extraction has no practical limit since
# only the extracted text is sent. 10 MB is a safe default for most receipts.
# R2S_MAX_FILE_SIZE_MB=10
