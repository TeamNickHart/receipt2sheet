{
  "name": "receipt2sheet",
  "version": "0.2.0",
  "description": "CLI tool for rental property owners to process receipts into organized expense spreadsheets using Claude AI",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "r2s": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "fixtures:record": "tsx scripts/record-api-responses.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/",
    "validate": "pnpm typecheck && pnpm format:check && pnpm lint && pnpm build && pnpm test"
  },
  "keywords": [
    "receipt",
    "expense",
    "spreadsheet",
    "rental",
    "schedule-e",
    "tax",
    "claude",
    "ai"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@inquirer/prompts": "^8.4.3",
    "chalk": "^5.4.0",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "pdf-parse": "^1.1.1",
    "yaml": "^2.7.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.15.0",
    "@types/pdf-parse": "^1.1.4",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.4.0",
    "pdfkit": "^0.18.0",
    "prettier": "^3.8.3",
    "tsx": "^4.22.2",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.59.3",
    "vitest": "^3.1.0"
  },
  "packageManager": "pnpm@10.26.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
